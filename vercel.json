{
  "version": 2,
  "ignoreCommand": "exit 1",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["backend/**"],
        "excludeFiles": "{android/**,ios/**,docs/**}"
      }
    },
    { "src": "package.json", "use": "@vercel/next" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" }
  ]
}

DATABASE_URL=sqlite:///./HivePulse.db
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Push — Android (FCM HTTP v1). See docs/push-setup.md; push is skipped while empty.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Push — iOS (APNs, token based)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_P8=
APNS_BUNDLE_ID=com.hivepulse.app
APNS_SANDBOX=false

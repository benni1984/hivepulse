/* Guided tours (#449) */
"tour.next" = "Siguiente";
"tour.close" = "Salir del tour";
"tour.skipStep" = "Saltar este paso";
"tour.lost" = "El control de este paso no está en esta pantalla. Abre la pantalla a la que pertenece, o sal del tour.";
"tour.listTitle" = "Tours guiados";
"tour.listIntro" = "Cada uno señala el botón de verdad en la pantalla de verdad y espera a que lo pulses. Empieza cualquiera cuando quieras — aquí nada ocurre solo una vez.";
"tour.listStart" = "Empezar";
"tour.listDone" = "visto";
"tour.firstSteps.title" = "Tu primera colonia";
"tour.firstSteps.summary" = "De una cuenta vacía a una primera revisión registrada.";
"tour.firstSteps.step1" = "Un colmenar es un lugar donde están tus colonias — un jardín, un frutal, un rincón en la ladera. Empieza por uno.";
"tour.firstSteps.step2" = "Dale el nombre que usarías en voz alta. Lo leerás bajo la lluvia.";
"tour.firstSteps.step3" = "Guárdalo. Todo lo demás depende de un colmenar.";
"tour.firstSteps.step4" = "Ábrelo. Las colonias viven dentro de un colmenar.";
"tour.firstSteps.step5" = "Añade una colonia. No necesitas un código QR impreso para esto — la pegatina es un atajo a una colonia que ya existe, no un requisito para crearla.";
"tour.offline.title" = "Funciona sin cobertura";
"tour.offline.summary" = "Lo único que no se descubre mirando, y lo que importa en el colmenar.";
"tour.offline.step1" = "Regístrala aquí y se escribe primero en el teléfono y luego se envía. Sin cobertura espera, marcada «Esperando subida» en la lista, y sale en cuanto hay conexión. No se pierde nada si te quedas sin cobertura a mitad de la visita — y esa es toda la razón de que esta pantalla funcione así.";
"tour.qrCodes.title" = "Las pegatinas QR, y para qué sirven";
"tour.qrCodes.summary" = "Una hoja de pegatinas, impresa una vez, y una colmena queda a un escaneo de distancia el resto de su vida.";
"tour.qrCodes.step1" = "Los lotes de QR están aquí arriba, en la barra de la lista de colmenares. Un lote es una hoja de pegatinas; los códigos tienen que existir antes de poder significar una colmena.";
"tour.qrCodes.step2" = "Crea uno. Coge más pegatinas de las colmenas que tienes — una hoja de reserva en la caseta no cuesta nada, y una pegatina que nadie ha escaneado no pertenece a ninguna colmena. La hoja se imprime desde la web; aquí es donde nacen los códigos.";
"tour.qrCodes.step3" = "Y para esto sirven. La pestaña Escanear abre la cámara directamente — acércala a una pegatina y esa colmena se abre. Sin lista, sin buscar, con una mano libre. Una pegatina que nadie ha escaneado se ofrece a la siguiente colmena que crees.";
"tour.hornets.title" = "Una trampa, y qué se hace con ella a diario";
"tour.hornets.summary" = "Registrar una trampa con nombre y luego apuntar lo que ha capturado. Un número al día es todo el trabajo.";
"tour.hornets.step1" = "El rastreador tiene su propia pestaña. Se trata de Vespa velutina, la avispa asiática — no del avispón europeo, que está protegido y no debe acabar en una trampa.";
"tour.hornets.step2" = "Una trampa aquí es una trampa física tuya, en un sitio, con un nombre. Regístrala una vez.";
"tour.hornets.step3" = "Un nombre que distingas en la oscuridad — «detrás de la caseta», no «trampa 2». La posición importa más que el nombre: el mapa solo vale lo que valen sus coordenadas.";
"tour.hornets.step4" = "Regístrala. Recibes un código de ocho caracteres — así vuelves a esta trampa desde otro dispositivo, sin cuenta.";
"tour.year.title" = "El año apícola, desplazado a tu región";
"tour.year.summary" = "Qué pasa cuándo, y por qué las fechas no son las mismas en una ladera que en un valle.";
"tour.year.step1" = "El año apícola está aquí arriba. Qué pasa cuándo — y las fechas no son las mismas en una ladera que en un valle, por eso se desplazan a tu región.";
"tour.year.step2" = "Y las fechas se mueven. Una temporada que llegó tres semanas antes no es un error del calendario, es este año — así que el calendario pregunta, aquí, y desplaza las fechas regionales cuando suficientes apicultores de un mismo sitio han dicho lo mismo.";
"tour.treatments.title" = "Tratamientos que no tendrás que recordar";
"tour.treatments.summary" = "Planificar uno con fecha, marcarlo cuando esté hecho, y el registro se escribe solo.";
"tour.treatments.step1" = "Los tratamientos pertenecen al colmenar, no a una colmena, porque así se trata de verdad contra varroa. Están en la barra del colmenar.";
"tour.treatments.step2" = "Planifica un tratamiento: qué, y para cuándo. Pertenece al colmenar entero, porque así se trata de verdad contra varroa — no colmena por colmena.";
"tour.sharing.title" = "Dejar que otro vea el colmenar";
"tour.sharing.summary" = "Una invitación por correo, y qué puede hacer la otra persona.";
"tour.sharing.step1" = "Un colmenar se puede compartir desde su barra. A quien dejas entrar lo ve y registra revisiones en él; no puede borrarlo, y puedes retirar el acceso en cualquier momento.";
"tour.sharing.step2" = "Invítala. Ve este colmenar y registra revisiones en él; no puede borrarlo, y puedes retirar el acceso aquí en cualquier momento.";
"tour.customFields.title" = "Apuntar lo que esta app no previó";
"tour.customFields.summary" = "Tu propio campo en cada revisión, con la forma que necesitas.";
"tour.customFields.step1" = "Nadie puede adivinar qué apuntas tú. Tus propios campos están aquí — partida de hidromiel, alimentación, el carácter de la reina.";
"tour.customFields.step2" = "Nadie puede adivinar qué apuntas tú. Partida de hidromiel, alimentación, el carácter de la reina — crea el campo tú mismo.";
"tour.moves.title" = "Trashumancia, y por qué conviene registrarla";
"tour.moves.summary" = "Llevar varias colmenas a otro colmenar de una vez, y conservar dónde han estado.";
"tour.moves.step1" = "Las colmenas viajan — a la colza, al brezo, lejos de un asentamiento que ya no lo es. Muévelas aquí en vez de editar cada colmena una por una.";
"tour.moves.step2" = "Y el mapa de traslados, en la barra de la lista de colmenares, dibuja después las líneas: dónde estuvo una colmena y cuándo se conserva, para que un año después sigas sabiendo si aquel viaje al brezo valió la pena.";
